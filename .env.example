# Bybit — CHAVE READ-ONLY OBRIGATORIA.
# Criar em: Bybit > Account & Security > API > Create New Key
#   - Permissoes: APENAS "Read" (Positions, Wallet). NUNCA Trade nem Withdraw.
#   - Restringir por IP sempre que possivel.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Usar a testnet para experimentar sem tocar na conta real.
BYBIT_TESTNET=false

# Moedas de liquidacao a sondar (separadas por virgula).
# linear  -> normalmente USDT
# inverse -> a moeda base de cada contrato (BTC, ETH, ...)
BYBIT_LINEAR_SETTLE=USDT
BYBIT_INVERSE_SETTLE=BTC,ETH
